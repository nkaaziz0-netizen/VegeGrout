# Supabase (used by app/api/inquiries/route.ts to store quote-form leads)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# WhatsApp Business number in international format, no + or spaces (e.g. 60123456789)
NEXT_PUBLIC_WHATSAPP_NUMBER=60123456789

# Optional: Resend API key, if you wire up email notifications for new leads
RESEND_API_KEY=
